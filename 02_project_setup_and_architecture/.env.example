# Academic Stress Detection & Student Feedback Platform - Environment Configuration

# Server Settings
PORT=8000
HOST=127.0.0.1
NODE_ENV=development

# Model Artifact Paths
MODEL_PATH=../04_preprocessing_and_nlp_training/saved_models/stress_classifier.joblib
VECTORIZER_PATH=../04_preprocessing_and_nlp_training/saved_models/tfidf_vectorizer.joblib
LABEL_ENCODER_PATH=../04_preprocessing_and_nlp_training/saved_models/label_encoder.joblib
METADATA_PATH=../04_preprocessing_and_nlp_training/saved_models/model_metadata.json

# API Endpoints
API_BASE_URL=http://127.0.0.1:8000/api
CORS_ORIGIN=*

# Stress Scoring Thresholds (0.0 to 1.0)
HIGH_STRESS_THRESHOLD=0.75
OVERLOAD_THRESHOLD=0.60
ALERT_NOTIFICATION_EMAIL=wellbeing-support@university.edu
