{
  "version": 2,
  "builds": [
    {
      "src": "05_backend_api_and_inference/api_server.py",
      "use": "@vercel/python"
    },
    {
      "src": "06_frontend_react_app/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "05_backend_api_and_inference/api_server.py"
    },
    {
      "src": "/(.*)",
      "dest": "06_frontend_react_app/$1"
    }
  ]
}
